package ch2;
/*
 * 	반복문
 * 
 * 	초기값;
 * 	while(조건){
 * 	실행문;
 * 	증감값;
 * }
 * 
 */

public class WhileEx1 {

	public static void main(String[] args) {
		// 1-5까지 출력
		int i =1;
		while(i<6) {
			// 반드시 증감의 값이 있어야 함
			System.out.println(i++);
		}
		System.out.println("===============");
		int n = 0;
		while(n<3) {
			System.out.println("빠잉~");
			n++;
		}
		System.out.println("===============");
		int k = 10;
		while(k>0) {
			System.out.println(k);
			k--;
		}
		System.out.println("===============");
		int e_n = 2;
		while(e_n<11) {
			//2~10까지 중 짝수만 출력
			System.out.println(e_n);
			e_n+=2;
		}
	}

}

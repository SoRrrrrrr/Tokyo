package ch2;
import java.util.Scanner;
/*
 * for 반복문
 * 정해진 조건만큼 반복
 * 
 * for(초기값; 조건식; 증감값){
 * 	실행문;
 * }
 * 
 */
 
public class ForEx1 {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		// 1~5까지 출력 
		// i++ : 후위증가
		// ++i : 전위증가
		// --i : 전위감소
		for(int i=1;i<6;i++) {
			System.out.println(i);
		}
		System.out.println("===========");
		//빠잉~ 3번 출력
		for(int a=0;a<3;a++) {
			System.out.println("빠잉~");
		}
		System.out.println("===========");
		// 10-1까지 거꾸로 출력
		for(int b=10; b>0 ; b--) {
			System.out.println(b);
		}
		System.out.println("===========");
		// 1-10까지 중 홀수만 출력(if문 없이)
		for(int c=1; c<=10 ; c+=2) {
			System.out.println(c);
		}
		System.out.println("===========");
		// 1~5까지의 합
		int sum = 0;
		for(int d=1; d<6; d++) {
			sum+=d;
		}
		System.out.println("합계: "+sum);
		System.out.println("===========");
		//정수를 입력 받아 그 수만큼 숫자 출력
		int num = sc.nextInt();
		for(int i=0;i<=num;i++) {
			System.out.println(i);
		}
		// 배열 Array : 여러 개의 값을 한 번에 저장한 변수, 인덱스를 가짐
		// 한 번 크기를 정하면 변경할 수 없고 같은 자료형만 저장 가능
		// 자료형[] 배열명 = {};, 자료형[] 배열명 = new 자료형[크기];
		// 읽는 방식 : 배열명[인덱스번호]
		int[] nums = { 3,5,7,9 };
		
		for(int i=0;i<len(nums);i++) {
			System.out.println(nums[i]);
		}
	}

}
